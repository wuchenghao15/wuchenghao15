# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.zip binary
*.tar.gz binary
*.mp4 binary
*.wav binary
*.ogg binary

# Python files
*.py diff=python

# JavaScript files
*.js diff=javascript

# JSON files
*.json diff=json

# HTML files
*.html diff=html

# CSS files  
*.css diff=css

# Shell scripts
*.sh diff=shell

# Executable scripts
*.py executable
*.sh executable

# Large files
*.mp4 -diff
*.pdf -diff
