{
    "description": "MTSCOS AI 智能教育平台 - Flask后端项目",
    "files": [
        {
            "name": "flask-app",
            "type": "folder",
            "children": [
                {
                    "name": "app.py",
                    "type": "file",
                    "desc": "Flask应用主入口"
                },
                {
                    "name": "app",
                    "type": "folder",
                    "desc": "应用核心代码",
                    "children": [
                        {
                            "name": "__init__.py",
                            "type": "file",
                            "desc": "应用初始化"
                        },
                        {
                            "name": "routes",
                            "type": "folder",
                            "desc": "路由定义"
                        },
                        {
                            "name": "models",
                            "type": "folder",
                            "desc": "数据模型"
                        },
                        {
                            "name": "services",
                            "type": "folder",
                            "desc": "业务服务"
                        },
                        {
                            "name": "exceptions",
                            "type": "folder",
                            "desc": "自定义异常"
                        },
                        {
                            "name": "ai_engines",
                            "type": "folder",
                            "desc": "AI引擎"
                        }
                    ]
                },
                {
                    "name": "templates",
                    "type": "folder",
                    "desc": "Jinja2模板"
                },
                {
                    "name": "src/html",
                    "type": "folder",
                    "desc": "静态资源",
                    "children": [
                        {
                            "name": "assets",
                            "type": "folder",
                            "desc": "资源文件",
                            "children": [
                                {
                                    "name": "css",
                                    "type": "folder",
                                    "desc": "样式文件"
                                },
                                {
                                    "name": "js",
                                    "type": "folder",
                                    "desc": "JavaScript文件"
                                },
                                {
                                    "name": "images",
                                    "type": "folder",
                                    "desc": "图片资源"
                                },
                                {
                                    "name": "font-awesome",
                                    "type": "folder",
                                    "desc": "Font Awesome图标"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "static",
                    "type": "folder",
                    "desc": "Flask静态文件"
                },
                {
                    "name": "scripts",
                    "type": "folder",
                    "desc": "辅助脚本"
                },
                {
                    "name": "tests",
                    "type": "folder",
                    "desc": "测试文件"
                },
                {
                    "name": "backups",
                    "type": "folder",
                    "desc": "备份文件"
                },
                {
                    "name": "requirements.txt",
                    "type": "file",
                    "desc": "Python依赖"
                },
                {
                    "name": ".env",
                    "type": "file",
                    "desc": "环境变量"
                },
                {
                    "name": "README.md",
                    "type": "file",
                    "desc": "项目说明"
                }
            ]
        }
    ],
    "build": {
        "toolType": "external",
        "command": "python app.py",
        "args": [],
        "cwd": "./flask-app",
        "target": "http://localhost:8888"
    },
    "compile": {
        "include": [
            "flask-app/**/*.py",
            "flask-app/**/*.html",
            "flask-app/**/*.css",
            "flask-app/**/*.js"
        ],
        "exclude": [
            "flask-app/backups/**",
            "flask-app/__pycache__/**",
            "flask-app/.git/**"
        ]
    },
    "settings": {
        "editor": {
            "tabSize": 4,
            "fontSize": 14,
            "theme": "dark"
        },
        "run": {
            "port": 8888,
            "host": "0.0.0.0"
        }
    }
}