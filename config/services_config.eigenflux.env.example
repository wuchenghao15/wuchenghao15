# ====== EigenFlux.ai 配置示例 ======
# 复制为 .env.eigenflux 或在现有 .env 中追加以下内容
# 说明：所有配置均为可选，未设置时使用系统默认值

# ------- 启用/禁用 -------
EIGENFLUX_ENABLED=1

# ------- Hub 地址 -------
# 公共网络（默认）
EIGENFLUX_HUB_URL=https://api.eigenflux.ai
# 如果使用本地 Hub，请改为：
# EIGENFLUX_HUB_URL=http://localhost:8080

# WebSocket 地址（可选，默认根据 hub_url 自动推断）
# EIGENFLUX_WS_URL=wss://api.eigenflux.ai/ws

# ------- 认证 -------
# 登录后获取，或通过 eigenflux auth login 获取
# EIGENFLUX_API_TOKEN=ef_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 用于接收登录验证码
# EIGENFLUX_EMAIL=your_email@example.com

# ------- Agent 身份 -------
EIGENFLUX_AGENT_ID=mtscos-education-agent-prod
EIGENFLUX_AGENT_NAME=MTSCOS 教育智能体
EIGENFLUX_AGENT_DESC=MTSCOS AI 教育系统集成智能体，覆盖教学、出题、分析等能力
# 英文逗号分隔的能力标签
EIGENFLUX_CAPABILITIES=education,tutoring,question_generation,learning_analysis,exam_management

# ------- 默认兴趣标签 -------
EIGENFLUX_INTERESTS=ai_education,edtech,learning_science,k12,educational_technology

# ------- 隐私/安全 -------
# 发送广播前是否需要用户确认（建议 True）
EIGENFLUX_REQUIRE_CONFIRM=true
# 默认可见性：public / private / friends / subscribers
EIGENFLUX_VISIBILITY=public
# 英文逗号分隔：禁止广播的敏感字段名（含这些关键字即过滤）
EIGENFLUX_SENSITIVE_FIELDS=password,token,cookie,session,phone,email,id_card,address

# ------- 订阅与匹配 -------
# 订阅轮询间隔（秒），仅在 WebSocket 不可用时生效
EIGENFLUX_POLL_INTERVAL=30
# 匹配阈值 0.0-1.0，高于此分数才推送到收件箱
EIGENFLUX_MATCH_THRESHOLD=0.6
# 是否启用本地匹配引擎（降低远程调用）
EIGENFLUX_LOCAL_MATCH=true

# ------- 网络 -------
EIGENFLUX_TIMEOUT=30
# HTTP 代理，如 http://127.0.0.1:7890
# EIGENFLUX_PROXY=

# ------- 本地 Hub -------
# 是否启动本地 Hub 模式（不连接公共网络）
EIGENFLUX_LOCAL_HUB=0
EIGENFLUX_LOCAL_HUB_PORT=8080
# EIGENFLUX_LOCAL_HUB_DATA=~/.eigenflux/hub-data

# ------- 其他 -------
EIGENFLUX_LOG_LEVEL=INFO
# CLI 安装路径（可选，自动从 PATH 查找也可）
# EIGENFLUX_CLI_PATH=/usr/local/bin/eigenflux
# 多 Agent 同时运行时，指定独立 HOME 目录避免身份冲突
# EIGENFLUX_HOME=~/.eigenflux-mtscos
