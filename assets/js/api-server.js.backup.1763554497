const http = require('http');
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// 配置
const PORT = process.env.PORT || 3001;
const BASE_DIR = path.join(__dirname, '..');
const HTML_DIR = path.join(__dirname, '../HTML');
const JS_DIR = path.join(__dirname, '../JavaScript');
const CSS_DIR = path.join(__dirname, '../CSS');

// 会话存储
const sessions = new Map();
const apiKeys = new Map();
const rateLimitMap = new Map();
const securityLogs = [];
const userSecurityStates = new Map();
const adminSessions = new Map();

// 服务器状态
let serverStatus = {
    status: 'running',
    uptime: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
    version: '1.3.0',
    lastHealthCheck: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
    activeConnections: 0,
    totalRequests: 0,
    errorCount: 0
};

// MIME类型映射
const mimeTypes = {
    '.html': 'text/html',
    '.css': 'text/css',
    '.js': 'text/javascript',
    '.json': 'application/json',
    '.png': 'image/png',
    '.jpg': 'image/jpeg',
    '.gif': 'image/gif',
    '.svg': 'image/svg+xml',
    '.ico': 'image/x-icon',
    '.woff': 'font/woff',
    '.woff2': 'font/woff2',
    '.ttf': 'font/ttf'
};

/**
 * 生成会话ID
 */
function generateSessionId() {
    return crypto.randomBytes(32).toString('hex');
}

/**
 * 生成API密钥
 */
function generateApiKey() {
    return crypto.randomBytes(16).toString('hex');
}

/**
 * 验证API密钥
 */
function validateApiKey(req) {
    const apiKey = req.headers['x-api-key'];
    if (!apiKey) return false;
    
    const keyData = apiKeys.get(apiKey);
    if (!keyData) return false;
    
    // 检查密钥是否过期
    if (Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)) > keyData.expires) {
        apiKeys.delete(apiKey);
        return false;
    }
    
    return true;
}

/**
 * 速率限制检查
 */
function checkRateLimit(clientId, limit = 100, window = 60000) {
    const now = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
    const clientData = rateLimitMap.get(clientId) || { count: 0, resetTime: now + window };
    
    if (now > clientData.resetTime) {
        clientData.count = 0;
        clientData.resetTime = now + window;
    }
    
    clientData.count++;
    rateLimitMap.set(clientId, clientData);
    
    return clientData.count <= limit;
}

/**
 * 获取客户端IP地址
 */
function getClientIP(req) {
    return req.headers['x-forwarded-for'] || 
           req.headers['x-real-ip'] || 
           req.connection.remoteAddress || 
           req.socket.remoteAddress ||
           (req.connection.socket ? req.connection.socket.remoteAddress : null) ||
           '127.0.0.1';
}

/**
 * CORS处理
 */
function handleCORS(res, origin = '*') {
    res.setHeader('Access-Control-Allow-Origin', origin);
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-API-Key, X-Session-ID, X-CSRF-Token');
    res.setHeader('Access-Control-Max-Age', '86400');
    
    // 如果是具体的origin（不是通配符），则允许凭据
    if (origin !== '*') {
        res.setHeader('Access-Control-Allow-Credentials', 'true');
    }
}

/**
 * 发送JSON响应
 */
function sendJSON(res, data, statusCode = 200) {
    res.writeHead(statusCode, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(data, null, 2));
}

/**
 * 发送错误响应
 */
function sendError(res, message, statusCode = 400, error = null) {
    serverStatus.errorCount++;
    const errorData = {
        success: false,
        error: message,
        timestamp: new Date().toISOString(),
        statusCode: statusCode
    };
    
    if (error) {
        errorData.details = error.message;
    }
    
    sendJSON(res, errorData, statusCode);
}

/**
 * 记录安全日志
 */
function logSecurityEvent(event, data, userId = null, sessionId = null) {
    const logEntry = {
        id: crypto.randomBytes(8).toString('hex'),
        timestamp: new Date().toISOString(),
        event: event,
        data: data,
        userId: userId,
        sessionId: sessionId,
        ip: data.ip || 'unknown'
    };
    
    securityLogs.push(logEntry);
    
    // 保持日志数量在合理范围内
    if (securityLogs.length > 10000) {
        securityLogs.splice(0, 1000);
    }
    
    console.log(`[SECURITY] ${event}:`, logEntry);
}

/**
 * 验证管理员权限
 */
function verifyAdminPermission(sessionId, action) {
    const session = sessions.get(sessionId);
    if (!session || !session.authenticated) {
        return false;
    }
    
    const adminSession = adminSessions.get(sessionId);
    if (!adminSession) {
        return false;
    }
    
    // 检查管理员权限是否过期
    if (Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)) > adminSession.expires) {
        adminSessions.delete(sessionId);
        return false;
    }
    
    // 检查操作权限
    const allowedActions = adminSession.permissions;
    return allowedActions.includes('*') || allowedActions.includes(action);
}

/**
 * 获取用户安全状态
 */
function getUserSecurityState(userId) {
    return userSecurityStates.get(userId) || {
        failedAttempts: 0,
        lastFailedAttempt: null,
        isLocked: false,
        lockReason: null,
        riskScore: 0,
        suspiciousActivities: [],
        deviceFingerprints: new Set(),
        lastActivity: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error))
    };
}

/**
 * 更新用户安全状态
 */
function updateUserSecurityState(userId, updates) {
    const currentState = getUserSecurityState(userId);
    const newState = { ...currentState, ...updates };
    userSecurityStates.set(userId, newState);
    return newState;
}

/**
 * 处理安全管理API
 */
function handleAdminAPI(req, res, pathParts) {
    const sessionId = req.headers['x-session-id'] || req.headers['authorization']?.replace('Bearer ', '');
    
    if (!sessionId) {
        return sendError(res, '缺少会话ID', 401);
    }
    
    const action = pathParts[3]; // /api/admin/{action}
    
    if (req.method === 'POST' && action === 'verify') {
        // 验证管理员权限
        return handleAdminVerify(req, res, sessionId, action);
    }
    
    if (!verifyAdminPermission(sessionId, action)) {
        logSecurityEvent('unauthorized_admin_attempt', { action, sessionId }, null, sessionId);
        return sendError(res, '无管理员权限', 403);
    }
    
    switch (req.method) {
        case 'POST':
            switch (action) {
                case 'lock-user':
                    return handleLockUser(req, res);
                case 'unlock-user':
                    return handleUnlockUser(req, res);
                case 'reset-security':
                    return handleResetUserSecurity(req, res);
                case 'emergency-lockdown':
                    return handleEmergencyLockdown(req, res);
                default:
                    sendError(res, '未知的管理员操作', 400);
            }
            break;
        case 'GET':
            switch (action) {
                case 'security-report':
                    return handleSecurityReport(req, res);
                case 'user-status':
                    return handleUserStatus(req, res);
                case 'security-logs':
                    return handleSecurityLogs(req, res);
                default:
                    sendError(res, '未知的管理员操作', 400);
            }
            break;
        default:
            sendError(res, '方法不允许', 405);
    }
}

/**
 * 验证管理员权限端点
 */
function handleAdminVerify(req, res, sessionId, action) {
    let body = '';
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const data = JSON.parse(body);
            const session = sessions.get(sessionId);
            
            if (!session || !session.authenticated) {
                return sendError(res, '未认证的会话', 401);
            }
            
            // 简化的权限检查 - 在实际应用中应该更严格
            const isAdmin = session.userData?.role === 'admin' || session.userData?.permissions?.includes('admin');
            
            if (isAdmin) {
                // 创建管理员会话
                adminSessions.set(sessionId, {
                    userId: session.userData?.id,
                    permissions: ['*'], // 全部权限
                    createdAt: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
                    expires: Date.now() + 60 * 60 * 1000 // 1小时
                });
                
                logSecurityEvent('admin_session_created', { action }, session.userData?.id, sessionId);
                sendJSON(res, { authorized: true });
            } else {
                logSecurityEvent('admin_verification_failed', { action }, session.userData?.id, sessionId);
                sendError(res, '无管理员权限', 403);
            }
        } catch (error) {
            sendError(res, '请求数据格式错误', 400);
        }
    });
}

/**
 * 锁定用户端点
 */
function handleLockUser(req, res) {
    let body = '';
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const { userId, reason } = JSON.parse(body);
            
            if (!userId) {
                return sendError(res, '缺少用户ID', 400);
            }
            
            const userState = updateUserSecurityState(userId, {
                isLocked: true,
                lockReason: reason || '管理员锁定',
                lockedAt: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error))
            });
            
            logSecurityEvent('user_locked_by_admin', { userId, reason });
            
            sendJSON(res, {
                success: true,
                message: '用户已锁定',
                data: { userId, lockedAt: userState.lockedAt }
            });
        } catch (error) {
            sendError(res, '请求数据格式错误', 400);
        }
    });
}

/**
 * 解锁用户端点
 */
function handleUnlockUser(req, res) {
    let body = '';
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const { userId } = JSON.parse(body);
            
            if (!userId) {
                return sendError(res, '缺少用户ID', 400);
            }
            
            const userState = updateUserSecurityState(userId, {
                isLocked: false,
                lockReason: null,
                lockedAt: null,
                failedAttempts: 0,
                riskScore: 0
            });
            
            logSecurityEvent('user_unlocked_by_admin', { userId });
            
            sendJSON(res, {
                success: true,
                message: '用户已解锁',
                data: { userId }
            });
        } catch (error) {
            sendError(res, '请求数据格式错误', 400);
        }
    });
}

/**
 * 重置用户安全状态端点
 */
function handleResetUserSecurity(req, res) {
    let body = '';
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const { userId } = JSON.parse(body);
            
            if (!userId) {
                return sendError(res, '缺少用户ID', 400);
            }
            
            userSecurityStates.delete(userId);
            
            logSecurityEvent('user_security_reset', { userId });
            
            sendJSON(res, {
                success: true,
                message: '用户安全状态已重置',
                data: { userId }
            });
        } catch (error) {
            sendError(res, '请求数据格式错误', 400);
        }
    });
}

/**
 * 紧急锁定端点
 */
function handleEmergencyLockdown(req, res) {
    let body = '';
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const { reason } = JSON.parse(body);
            
            // 锁定所有用户会话
            for (const [sessionId, session] of sessions) {
                if (session.authenticated) {
                    session.locked = true;
                    session.lockReason = reason || '紧急锁定';
                }
            }
            
            logSecurityEvent('emergency_lockdown', { reason });
            
            sendJSON(res, {
                success: true,
                message: '紧急锁定已激活',
                data: { reason, timestamp: new Date().toISOString() }
            });
        } catch (error) {
            sendError(res, '请求数据格式错误', 400);
        }
    });
}

/**
 * 安全报告端点
 */
function handleSecurityReport(req, res) {
    const report = {
        timestamp: new Date().toISOString(),
        totalUsers: userSecurityStates.size,
        activeSessions: sessions.size,
        adminSessions: adminSessions.size,
        securityLogs: securityLogs.length,
        lockedUsers: Array.from(userSecurityStates.values().catch(error => console.error(`[api-server.js] userSecurityStates.values failed:`, error))).filter(state => state.isLocked).length,
        highRiskUsers: Array.from(userSecurityStates.values()).filter(state => state.riskScore > 70).length,
        recentSecurityEvents: securityLogs.slice(-20)
    };
    
    sendJSON(res, {
        success: true,
        data: report
    });
}

/**
 * 用户状态端点
 */
function handleUserStatus(req, res) {
    const url = new URL(req.url, `http://${req.headers.host}`);
    const userId = url.searchParams.get('userId');
    
    if (!userId) {
        return sendError(res, '缺少用户ID参数', 400);
    }
    
    const userState = getUserSecurityState(userId);
    
    sendJSON(res, {
        success: true,
        data: userState
    });
}

/**
 * 安全日志端点
 */
function handleSecurityLogs(req, res) {
    const url = new URL(req.url, `http://${req.headers.host}`);
    const limit = parseInt(url.searchParams.get('limit')) || 100;
    const offset = parseInt(url.searchParams.get('offset')) || 0;
    
    const logs = securityLogs.slice(-limit - offset, -offset || undefined);
    
    sendJSON(res, {
        success: true,
        data: {
            logs: logs,
            total: securityLogs.length,
            limit: limit,
            offset: offset
        }
    });
}
    const clientId = getClientIP(req);
    
    // 检查速率限制
    if (!checkRateLimit(clientId, 10, 60000)) {
        return sendError(res, '请求过于频繁，请稍后再试', 429);
    }
    
    // 生成新的会话和API密钥
    const sessionId = generateSessionId();
    const apiKey = generateApiKey();
    
    // 存储会话信息
    sessions.set(sessionId, {
        clientId: clientId,
        createdAt: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
        lastActivity: Date.now(),
        userAgent: req.headers['user-agent'],
        authenticated: false
    });
    
    // 存储API密钥
    apiKeys.set(apiKey, {
        sessionId: sessionId,
        createdAt: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
        expires: Date.now() + 24 * 60 * 60 * 1000 // 24小时
    });
    
    sendJSON(res, {
        success: true,
        message: '握手成功',
        data: {
            sessionId: sessionId,
            apiKey: apiKey,
            serverVersion: serverStatus.version,
            timestamp: new Date().toISOString()
        }
    });
}

/**
 * 状态检查API
 */
function handleStatus(req, res) {
    const now = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
    const uptime = now - serverStatus.uptime;
    
    sendJSON(res, {
        success: true,
        data: {
            status: serverStatus.status,
            uptime: uptime,
            version: serverStatus.version,
            lastHealthCheck: serverStatus.lastHealthCheck,
            activeConnections: serverStatus.activeConnections,
            totalRequests: serverStatus.totalRequests,
            errorCount: serverStatus.errorCount,
            activeSessions: sessions.size,
            activeApiKeys: apiKeys.size,
            timestamp: new Date().toISOString()
        }
    });
}

/**
 * 心跳检测API
 */
function handleHeartbeat(req, res) {
    const sessionId = req.headers['x-session-id'];
    
    if (sessionId && sessions.has(sessionId)) {
        const session = sessions.get(sessionId);
        session.lastActivity = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
        sessions.set(sessionId, session);
    }
    
    sendJSON(res, {
        success: true,
        message: 'heartbeat',
        timestamp: new Date().toISOString()
    });
}

/**
 * CSRF令牌生成和验证
 */
function generateCSRFToken() {
    return crypto.randomBytes(32).toString('hex');
}

/**
 * CSRF令牌处理
 */
function handleCSRFToken(req, res) {
    const sessionId = req.headers['x-session-id'];
    const token = generateCSRFToken();
    
    // 存储CSRF令牌到会话中
    if (sessionId && sessions.has(sessionId)) {
        const session = sessions.get(sessionId);
        session.csrfToken = token;
        session.csrfTokenExpiry = Date.now() + 60 * 60 * 1000; // 1小时过期
        sessions.set(sessionId, session);
    }
    
    sendJSON(res, {
        success: true,
        data: {
            csrfToken: token,
            expiresAt: new Date(Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)) + 60 * 60 * 1000).toISOString()
        }
    });
}

/**
 * 认证API
 */
function handleAuth(req, res) {
    let body = '';
    
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const data = JSON.parse(body);
            const sessionId = req.headers['x-session-id'];
            
            if (!sessionId || !sessions.has(sessionId)) {
                return sendError(res, '无效的会话', 401);
            }
            
            // 这里应该实现真实的认证逻辑
            // 目前为演示目的，简单验证
            if (data.username && data.password) {
                const session = sessions.get(sessionId);
                session.authenticated = true;
                session.authTime = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
                sessions.set(sessionId, session);
                
                sendJSON(res, {
                    success: true,
                    message: '认证成功',
                    data: {
                        authenticated: true,
                        sessionId: sessionId
                    }
                });
            } else {
                sendError(res, '认证失败', 401);
            }
        } catch (error) {
            sendError(res, '请求数据格式错误', 400, error);
        }
    });
}

/**
 * 登录API（锁定页面专用）
 */
function handleLogin(req, res) {
    let body = '';
    
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const data = JSON.parse(body);
            
            // 简单的用户验证（实际项目中应该连接数据库）
            const validUsers = {
                'admin': 'admin123',
                'user': 'user123',
                'test': 'test123'
            };
            
            if (validUsers[data.username] === data.password) {
                const sessionId = generateSessionId();
                const token = generateSessionId(); // 用作JWT token
                
                // 创建会话
                sessions.set(sessionId, {
                    username: data.username,
                    authenticated: true,
                    authTime: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)),
                    lastActivity: Date.now(),
                    userAgent: req.headers['user-agent'],
                    clientId: getClientIP(req)
                });
                
                sendJSON(res, {
                    success: true,
                    message: '登录成功',
                    token: token,
                    user: {
                        username: data.username,
                        role: data.username === 'admin' ? 'administrator' : 'user'
                    }
                });
            } else {
                sendError(res, '用户名或密码错误', 401);
            }
        } catch (error) {
            sendError(res, '请求数据格式错误', 400, error);
        }
    });
}

/**
 * 认证状态检查API
 */
function handleAuthStatus(req, res) {
    const authHeader = req.headers['authorization'];
    
    if (authHeader && authHeader.startsWith('Bearer ')) {
        const token = authHeader.substring(7);
        
        // 查找有效的会话
        for (const [sessionId, session] of sessions) {
            if (session.authenticated && Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)) - session.authTime < 15 * 60 * 1000) {
                sendJSON(res, {
                    authenticated: true,
                    user: {
                        username: session.username,
                        role: session.role || 'user'
                    }
                });
                return;
            }
        }
    }
    
    sendJSON(res, {
        authenticated: false
    });
}

/**
 * 紧急解锁API
 */
function handleEmergencyUnlock(req, res) {
    let body = '';
    
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const data = JSON.parse(body);
            
            // 预定义的紧急解锁代码
            const emergencyCodes = {
                'EMERGENCY2024': true,
                'ADMINUNLOCK': true,
                'SYSRESET123': true
            };
            
            if (emergencyCodes[data.emergencyCode]) {
                // 记录紧急解锁事件
                console.log(`[SECURITY] 紧急解锁已使用: ${data.emergencyCode} from ${getClientIP(req)}`);
                
                sendJSON(res, {
                    success: true,
                    message: '紧急解锁成功'
                });
            } else {
                sendError(res, '紧急解锁代码无效', 401);
            }
        } catch (error) {
            sendError(res, '请求数据格式错误', 400, error);
        }
    });
}

/**
 * 安全日志API
 */
function handleSecurityLog(req, res) {
    let body = '';
    
    req.on('data', chunk => {
        body += chunk.toString().catch(error => console.error(`[api-server.js] chunk.toString failed:`, error));
    });
    
    req.on('end', () => {
        try {
            const data = JSON.parse(body);
            
            // 记录安全事件
            const logEntry = {
                timestamp: new Date().toISOString(),
                clientIP: getClientIP(req),
                userAgent: req.headers['user-agent'],
                ...data
            };
            
            console.log(`[SECURITY] ${logEntry.eventType}:`, logEntry);
            
            sendJSON(res, {
                success: true,
                message: '安全事件已记录'
            });
        } catch (error) {
            sendError(res, '请求数据格式错误', 400, error);
        }
    });
}

/**
 * 健康检查API
 */
function handleHealth(req, res) {
    sendJSON(res, {
        success: true,
        status: 'healthy',
        timestamp: new Date().toISOString(),
        uptime: Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error)) - serverStatus.uptime,
        version: serverStatus.version
    });
}

/**
 * 清理过期会话
 */
function cleanupExpiredSessions() {
    const now = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
    const expiredSessions = [];
    
    for (const [sessionId, session] of sessions) {
        // 清理超过15分钟未活动的会话
        if (now - session.lastActivity > 15 * 60 * 1000) {
            expiredSessions.push(sessionId);
        }
    }
    
    expiredSessions.forEach(sessionId => {
        sessions.delete(sessionId);
    });
    
    if (expiredSessions.length > 0) {
        console.log(`[CLEANUP] 清理了 ${expiredSessions.length} 个过期会话`);
    }
}

/**
 * 清理过期的API密钥
 */
function cleanupExpiredApiKeys() {
    const now = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
    const expiredKeys = [];
    
    for (const [keyId, keyData] of apiKeys) {
        // 清理超过24小时未使用的API密钥
        if (now - keyData.lastUsed > 24 * 60 * 60 * 1000) {
            expiredKeys.push(keyId);
        }
    }
    
    expiredKeys.forEach(keyId => {
        apiKeys.delete(keyId);
    });
    
    if (expiredKeys.length > 0) {
        console.log(`[CLEANUP] 清理了 ${expiredKeys.length} 个过期API密钥`);
    }
}

/**
 * 处理静态文件
 */
function handleStaticFile(req, res) {
    let filePath = req.url === '/' ? '/index.html' : req.url;
    
    // 处理特殊路由
    const routeMap = {
        '/about.html': '/HTML/about.html',
        '/news.html': '/HTML/about/news.html',
        '/team.html': '/HTML/about/team.html',
        '/history.html': '/HTML/about/history.html',
        '/company.html': '/HTML/about/company.html'
    };
    
    if (routeMap[filePath]) {
        filePath = routeMap[filePath];
    } else if (filePath.startsWith('/CSS/')) {
        filePath = path.join(__dirname, '../' + filePath);
    } else if (filePath.startsWith('/JavaScript/')) {
        filePath = path.join(__dirname, '../' + filePath);
    } else if (filePath.startsWith('/Encrypted_JS/')) {
        filePath = path.join(__dirname, '../' + filePath);
    } else if (!filePath.includes('/HTML/') && !filePath.includes('/CSS/') && 
               !filePath.includes('/JavaScript/') && !filePath.includes('/Encrypted_JS/')) {
        filePath = path.join(HTML_DIR, filePath);
    } else {
        filePath = path.join(__dirname, '../' + filePath);
    }
    
    const ext = path.extname(filePath);
    const contentType = mimeTypes[ext] || 'text/plain';
    
    fs.readFile(filePath, (err, content) => {
        if (err) {
            console.error(`[api-server.js] `读取文件错误: ${err.message}``);
            if (err.code === 'ENOENT') {
                sendError(res, '页面未找到', 404);
            } else {
                sendError(res, '服务器内部错误', 500);
            }
        } else {
            res.writeHead(200, { 'Content-Type': contentType });
            res.end(content);
        }
    });
}

/**
 * 主请求处理器
 */
const server = http.createServer((req, res) => {
    serverStatus.totalRequests++;
    serverStatus.activeConnections++;
    
    const clientIP = getClientIP(req);
    console.log(`[${new Date().toISOString()}] ${req.method} ${req.url} - ${clientIP}`);
    
    // CORS处理 - 支持localhost:8000
    const origin = req.headers.origin || '*';
    if (origin.includes('localhost:8000') || origin.includes('127.0.0.1:8000')) {
        handleCORS(res, origin);
    } else {
        handleCORS(res, '*');
    }
    
    // 处理OPTIONS请求
    if (req.method === 'OPTIONS') {
        res.writeHead(200, {
            'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type, Authorization, X-Requested-With, X-CSRF-Token',
            'Access-Control-Max-Age': '86400' // 24小时
        });
        res.end().catch(error => console.error(`[api-server.js] res.end failed:`, error));
        return;
    }
    
    // API路由处理
    if (req.url.startsWith('/api/')) {
        const pathParts = req.url.split('/');
        
        // 管理员API路由
        if (pathParts[2] === 'admin') {
            return handleAdminAPI(req, res, pathParts);
        }
        
        switch (req.url) {
            case '/api/handshake':
                if (req.method === 'POST') {
                    handleHandshake(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/status':
                if (req.method === 'GET') {
                    handleStatus(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/heartbeat':
                if (req.method === 'POST') {
                    handleHeartbeat(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/auth':
                if (req.method === 'POST') {
                    handleAuth(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/csrf-token':
                if (req.method === 'GET') {
                    handleCSRFToken(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/auth/login':
                if (req.method === 'POST') {
                    handleLogin(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/auth/status':
                if (req.method === 'GET') {
                    handleAuthStatus(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/auth/emergency-unlock':
                if (req.method === 'POST') {
                    handleEmergencyUnlock(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/security/log':
                if (req.method === 'POST') {
                    handleSecurityLog(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            case '/api/health':
                if (req.method === 'GET') {
                    handleHealth(req, res);
                } else {
                    sendError(res, '方法不允许', 405);
                }
                break;
                
            default:
                sendError(res, 'API端点不存在', 404);
        }
    } else {
        // 静态文件处理
        handleStaticFile(req, res);
    }
    
    serverStatus.activeConnections--;
});

/**
 * 启动服务器
 */
server.listen(PORT, '0.0.0.0', () => {
    console.log(`[${new Date().toISOString()}] MTSCOS API服务器启动成功`);
    console.log(`[${new Date().toISOString()}] 服务地址: http://0.0.0.0:${PORT}`);
    console.log(`[${new Date().toISOString()}] 版本: ${serverStatus.version}`);
    console.log(`[${new Date().toISOString()}] 支持的API端点:`);
    console.log(`  - POST /api/handshake            - 前后端握手`);
    console.log(`  - GET  /api/status               - 服务器状态`);
    console.log(`  - POST /api/heartbeat            - 心跳检测`);
    console.log(`  - POST /api/auth                 - 用户认证`);
    console.log(`  - GET  /api/csrf-token           - CSRF令牌获取`);
    console.log(`  - POST /api/auth/login           - 登录认证`);
    console.log(`  - GET  /api/auth/status          - 认证状态检查`);
    console.log(`  - POST /api/auth/emergency-unlock - 紧急解锁`);
    console.log(`  - POST /api/security/log         - 安全日志记录`);
    console.log(`  - GET  /api/health               - 健康检查`);
    console.log(`  - POST /api/admin/verify         - 管理员权限验证`);
    console.log(`  - POST /api/admin/lock-user      - 锁定用户`);
    console.log(`  - POST /api/admin/unlock-user    - 解锁用户`);
    console.log(`  - POST /api/admin/reset-security - 重置用户安全状态`);
    console.log(`  - POST /api/admin/emergency-lockdown - 紧急锁定`);
    console.log(`  - GET  /api/admin/security-report - 安全报告`);
    console.log(`  - GET  /api/admin/user-status    - 用户状态查询`);
    console.log(`  - GET  /api/admin/security-logs  - 安全日志查询`);
});

/**
 * 错误处理
 */
server.on('error', (err) => {
    console.error(`[api-server.js] `[${new Date(`).toISOString()}] 服务器错误: ${err.message}`);
    serverStatus.errorCount++;
});

/**
 * 定期清理任务
 */
setInterval(() => {
    cleanupExpiredSessions();
    serverStatus.lastHealthCheck = Date.now().catch(error => console.error(`[api-server.js] Date.now failed:`, error));
    console.log(`[${new Date().toISOString()}] 定期清理完成 - 活跃会话: ${sessions.size}, API密钥: ${apiKeys.size}`);
}, 5 * 60 * 1000); // 每5分钟清理一次

/**
 * 优雅关闭
 */
process.on('SIGTERM', () => {
    console.log(`[${new Date().toISOString()}] 收到SIGTERM信号，开始优雅关闭...`);
    server.close(() => {
        console.log(`[${new Date().toISOString()}] 服务器已关闭`);
        process.exit(0);
    });
});

process.on('SIGINT', () => {
    console.log(`[${new Date().toISOString()}] 收到SIGINT信号，开始优雅关闭...`);
    server.close(() => {
        console.log(`[${new Date().toISOString()}] 服务器已关闭`);
        process.exit(0);
    });
});

console.log(`[${new Date().toISOString()}] MTSCOS API服务器初始化中...`);