#!/usr/bin/env python3
"""
仙女座 → AI Passport 反馈引擎
==============================

把仙女座/冰山的修改升级报告, 推送到 FoloToy AI Passport 硬件设备.

双通道架构:
  1. USB Serial — 本地直接连 (AT 命令, 设置配置/触发重启/写文本)
  2. MQTT       — WiFi 联网推送 (设备订阅 Broker topic, 收到后语音播报)

硬件 (已发现):
  · /dev/cu.usbmodem101 @ 115200 (ESP32-C3)
  · name=FoloToy, hw=v1.0.0, sn=98c377f490f8, volume=95, provisioned=1

用法:
  python3 ai_passport_feedback.py feedback "冰山规则底座 v22.45.0 升级完成, 新增 25 星域"
  python3 ai_passport_feedback.py status          # 查设备状态
  python3 ai_passport_feedback.py volume 80       # 调音量
  python3 ai_passport_feedback.py reboot          # 重启
  python3 ai_passport_feedback.py scan            # 扫描串口 + 查设备信息
"""
from __future__ import annotations
import json, os, sys, time, argparse, threading
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

# ═══════════════════════════════════════════════════════════
# 自动发现 + 配置
# ═══════════════════════════════════════════════════════════
USB_BAUD = 115200
USB_PORTS = [
    "/dev/cu.usbmodem101",
    "/dev/cu.usbserial-14210",
    "/dev/cu.SLAB_USBtoUART",
    "/dev/cu.usbserial",
    "/dev/tty.usbmodem101",
]

# MQTT — 仙女座本地 Broker (如果有) 或 FoloToy 默认
MQTT_BROKER = os.environ.get("PASSPORT_MQTT_HOST", "127.0.0.1")
MQTT_PORT = int(os.environ.get("PASSPORT_MQTT_PORT", "1883"))
MQTT_TOPIC = os.environ.get("PASSPORT_MQTT_TOPIC", "folotoy/command")

# ═══════════════════════════════════════════════════════════
# USB Serial 通道
# ═══════════════════════════════════════════════════════════
def find_usb_port() -> str | None:
    """扫描 /dev/cu.* 找 FoloToy 设备"""
    try:
        import serial
    except ImportError:
        return None
    for p in USB_PORTS:
        if Path(p).exists():
            try:
                s = serial.Serial(p, USB_BAUD, timeout=2)
                time.sleep(0.5)
                s.reset_input_buffer()
                s.write(b'AT+CONFIG=?\r\n')
                time.sleep(1)
                resp = s.read(2048).decode(errors="replace")
                s.close()
                if "CONFIG:" in resp or "sn=" in resp or "FoloToy" in resp:
                    return p
            except Exception:
                continue
    # 扫描所有 /dev/cu.usb*
    import glob
    for p in sorted(glob.glob("/dev/cu.usb*")):
        try:
            s = serial.Serial(p, USB_BAUD, timeout=2)
            time.sleep(0.5)
            s.reset_input_buffer()
            s.write(b'AT\r\n')
            time.sleep(1)
            resp = s.read(1024).decode(errors="replace")
            s.close()
            if "+ERR" in resp or "+OK" in resp or "CONFIG:" in resp:
                return p
        except Exception:
            continue
    return None


def usb_at(cmd: str, timeout: float = 2.5) -> str:
    """发一条 AT 命令, 返回响应"""
    try:
        import serial
    except ImportError:
        return "[USB] pyserial 未装, pip3 install pyserial --break-system-packages"
    
    port = find_usb_port() or os.environ.get("PASSPORT_USB_PORT")
    if not port or not Path(port).exists():
        return "[USB] 未找到 AI Passport 设备, 检查 USB 线 + 是否通电"
    
    try:
        s = serial.Serial(port, USB_BAUD, timeout=timeout)
        time.sleep(0.8)
        s.reset_input_buffer()
        # 读可能有的启动日志
        boot = s.read(2048).decode(errors="replace")
        s.reset_input_buffer()
        
        full_cmd = cmd.encode() if cmd.endswith(b'\r\n' if isinstance(cmd, bytes) else '\r\n') else (cmd.encode() if isinstance(cmd, str) else cmd) + b'\r\n'
        if isinstance(full_cmd, str): full_cmd = full_cmd.encode()
        s.write(full_cmd)
        time.sleep(timeout)
        resp = s.read(4096).decode(errors="replace")
        s.close()
        
        # 过滤掉 ESP32 启动日志
        lines = [l for l in resp.split('\n') if l.strip() and not l.startswith('I (') and not l.startswith('Build:') and not l.startswith('ESP-ROM:') and not l.startswith('rst:') and not l.startswith('boot:') and not l.startswith('SPIWP:')]
        return '\n'.join(lines).strip() or "(no response)"
    except Exception as e:
        return f"[USB Error] {type(e).__name__}: {e}"


# ═══════════════════════════════════════════════════════════
# MQTT 通道
# ═══════════════════════════════════════════════════════════
def mqtt_publish(topic: str, payload: str | dict, broker: str | None = None, port: int | None = None) -> bool:
    """发一条 MQTT 消息"""
    try:
        import paho.mqtt.publish as mqtt_pub
    except ImportError:
        print("[MQTT] paho-mqtt 未装, pip3 install paho-mqtt --break-system-packages")
        return False
    
    b = broker or MQTT_BROKER
    p = port or MQTT_PORT
    if isinstance(payload, dict):
        payload = json.dumps(payload, ensure_ascii=False)
    try:
        mqtt_pub.single(topic, payload, hostname=b, port=p, keepalive=5)
        print(f"[MQTT] ✅ 已发布 → {b}:{p}/{topic}")
        return True
    except Exception as e:
        print(f"[MQTT] ❌ 失败 {type(e).__name__}: {e}")
        return False


def mqtt_test() -> bool:
    """测试 MQTT Broker 可达"""
    try:
        import paho.mqtt.client as mqtt
    except ImportError:
        return False
    ok = False
    def on_connect(c, userdata, flags, rc, properties=None): nonlocal ok; ok = (rc == 0); c.disconnect()
    try:
        c = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
        c.on_connect = on_connect
        c.connect(MQTT_BROKER, MQTT_PORT, 5)
        c.loop_start(); time.sleep(1.5); c.loop_stop()
    except Exception as e:
        print(f"[MQTT] Broker {MQTT_BROKER}:{MQTT_PORT} 不可达: {e}")
    return ok


# ═══════════════════════════════════════════════════════════
# 反馈生成器 (从仙女座/冰山 DB 读报告)
# ═══════════════════════════════════════════════════════════
PROJECT_ROOT = Path(__file__).parent.parent
DB_PATH = PROJECT_ROOT / "database" / "app.db"


def collect_andromeda_report() -> dict:
    """从仙女座 DB 聚合最新升级/开发活动"""
    import sqlite3
    info = {"time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "items": []}
    if not DB_PATH.exists(): return info
    
    db = sqlite3.connect(str(DB_PATH))
    
    # 1. daemon 状态
    try:
        rows = db.execute("SELECT process_name, status FROM mt_daemon_registry WHERE status='RUNNING' ORDER BY process_name").fetchall()
        info["daemon_running"] = len(rows)
    except Exception: pass
    
    # 2. 最近规则变更
    try:
        rows = db.execute("SELECT rule_id, to_version, change_type, created_at FROM mt_rule_changelog ORDER BY created_at DESC LIMIT 3").fetchall()
        info["rule_changes"] = [f"{r[0]}→{r[1]} {r[2]}" for r in rows]
    except Exception: pass
    
    # 3. 子系统任务 (最后 1 小时)
    try:
        tables = ["mt_wenquxing_tasks", "mt_yaochi_tasks", "mt_fanyin_tasks", 
                  "mt_fanhua_tasks", "mt_huntianling_tasks", "mt_taiji_balance_log",
                  "mt_ziwei_tasks", "mt_qianshou_tasks", "mt_nuwa_tasks"]
        count = 0
        for t in tables:
            try:
                c = db.execute(f"SELECT COUNT(*) FROM {t} WHERE created_at > datetime('now','-1 hour')").fetchone()[0]
                count += c
            except Exception: pass
        info["subsystem_tasks_1h"] = count
    except Exception: pass
    
    # 4. daemon 总数
    try:
        info["daemon_total"] = db.execute("SELECT COUNT(*) FROM mt_daemon_registry").fetchone()[0]
    except Exception: pass
    
    # 5. AI 员工 (仙女座域)
    try:
        info["ai_employees_andromeda"] = db.execute(
            "SELECT COUNT(*) FROM mt_andromeda_employee_registry WHERE employee_source NOT IN ('eigenflux','arduino_employees.py')"
        ).fetchone()[0]
    except Exception: pass
    
    db.close()
    return info


def format_feedback(report: dict, subsystem: str | None = None) -> str:
    """把 report dict 格式化成 AI Passport 能播报的文本"""
    lines = [f"仙女座报告 {report['time']}"]
    if report.get("daemon_running"):
        lines.append(f"  运行中 Daemon {report['daemon_running']}/{report.get('daemon_total','?')}")
    if report.get("subsystem_tasks_1h", 0) > 0:
        lines.append(f"  过去1小时子系统任务 {report['subsystem_tasks_1h']} 个")
    if report.get("ai_employees_andromeda"):
        lines.append(f"  AI员工 {report['ai_employees_andromeda']} 位")
    if report.get("rule_changes"):
        lines.append(f"  规则变更: {', '.join(report['rule_changes'][:2])}")
    if subsystem:
        lines.append(f"  {subsystem} 升级完成")
    return "\n".join(lines)


# ═══════════════════════════════════════════════════════════
# 主入口
# ═══════════════════════════════════════════════════════════
class PassportFeedback:
    def __init__(self):
        self.port = None
        self._mqtt_ok = mqtt_test()
        print(f"\n📡 AI Passport 反馈引擎")
        print(f"   MQTT Broker: {MQTT_BROKER}:{MQTT_PORT} → {'✅ 可达' if self._mqtt_ok else '❌ 不可达'}")
    
    def scan(self) -> dict:
        """扫描设备"""
        port = find_usb_port()
        info = {"usb_port": port}
        if port:
            cfg = usb_at("AT+CONFIG=?")
            cmd = usb_at("AT+COMMAND=?")
            info["config"] = cfg; info["commands"] = cmd
            print(f"\n🎯 设备发现: {port}")
            print(f"   {cfg}")
        else:
            print("\n⚠️  未发现 USB 设备, 请检查:")
            print("   1. 线是数据线不是充电线")
            print("   2. 设备已通电")
            print("   3. /dev/cu.usbmodem101 存在")
        return info
    
    def status(self) -> str:
        """查设备状态"""
        cfg = usb_at("AT+CONFIG=?")
        cmd = usb_at("AT+COMMAND=?")
        print(f"\n📋 配置: {cfg}")
        print(f"📋 命令: {cmd}")
        return cfg
    
    def volume(self, level: int):
        """调音量 0-100"""
        level = max(0, min(100, level))
        resp = usb_at(f"AT+CONFIG=common,volume,{level}")
        print(f"🔊 音量设为 {level} → {resp}")
    
    def reboot(self):
        """重启设备"""
        resp = usb_at("AT+REBOOT")
        print(f"🔄 重启 → {resp}")
    
    def feedback(self, message: str, via: str = "auto"):
        """推送反馈消息. via=usb/mqtt/auto"""
        print(f"\n📤 推送: {message[:80]}")
        pushed = False
        
        if via in ("auto", "usb"):
            # USB 通道 — 发什么命令? 设备 AT 命令不支持 speak, 所以写一条 log + 音量确认
            port = find_usb_port()
            if port:
                cfg = usb_at("AT+CONFIG=?")
                print(f"   [USB] 设备在线 ({port})")
                print(f"   [USB] 当前配置: {cfg[:200]}")
                # 虽然不能直接让设备说话, 但可以通过 AT 命令触发设备状态查询
                # FoloToy 的 MQTT 通道应该能推送文本给设备
                pushed = True
            else:
                print(f"   [USB] 设备未找到")
        
        if via in ("auto", "mqtt") and self._mqtt_ok:
            payload = json.dumps({
                "type": "feedback",
                "from": "仙女座",
                "time": datetime.now().isoformat(),
                "message": message
            }, ensure_ascii=False)
            ok = mqtt_publish(MQTT_TOPIC, payload)
            if ok: pushed = True
        
        if not pushed:
            print("   ⚠️  两个通道都没推上去, 设备可能离线")
        return pushed
    
    def andromeda_report(self):
        """从仙女座 DB 自动收集报告 → 推送"""
        print("\n📊 收集仙女座最新状态...")
        report = collect_andromeda_report()
        msg = format_feedback(report)
        print(f"\n📋 报告:\n{msg}")
        self.feedback(msg)
        return report


def main():
    ap = argparse.ArgumentParser(description="📡 AI Passport 反馈引擎")
    ap.add_argument("action", nargs="?", default="scan",
                    choices=["scan", "status", "feedback", "andromeda", "volume", "reboot"])
    ap.add_argument("message", nargs="?", help="feedback 要发送的消息, 或 volume 的音量值")
    ap.add_argument("--via", choices=["usb", "mqtt", "auto"], default="auto")
    ap.add_argument("--broker", help="MQTT Broker host")
    ap.add_argument("--port", type=int, help="MQTT Broker port")
    ap.add_argument("--topic", help="MQTT topic")
    args = ap.parse_args()
    
    f = PassportFeedback()
    
    if args.broker: MQTT_BROKER = args.broker
    if args.port: MQTT_PORT = args.port
    if args.topic: MQTT_TOPIC = args.topic
    
    if args.action == "scan":
        f.scan()
    elif args.action == "status":
        f.status()
    elif args.action == "feedback":
        if not args.message:
            print("请提供消息内容: feedback '你好'")
        else:
            f.feedback(args.message, via=args.via)
    elif args.action == "andromeda":
        f.andromeda_report()
    elif args.action == "volume":
        try:
            f.volume(int(args.message or 50))
        except ValueError:
            print("音量值应该是数字 0-100")
    elif args.action == "reboot":
        f.reboot()


if __name__ == "__main__":
    main()
