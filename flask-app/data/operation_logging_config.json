{
  "logging": {
    "enabled": true,
    "levels": [
      "info",
      "warning",
      "error",
      "critical"
    ],
    "retention_days": 365
  },
  "log_types": [
    "login",
    "logout",
    "system_modification",
    "user_management",
    "exam_management",
    "approval_request",
    "approval_decision"
  ],
  "backup": {
    "enabled": true,
    "frequency": "daily",
    "retention_days": 90
  }
}