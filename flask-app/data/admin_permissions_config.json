{
  "admin_levels": {
    "level_1": {
      "name": "普通管理员",
      "permissions": [
        "view_dashboard",
        "manage_users",
        "view_reports"
      ],
      "approval_required": true
    },
    "level_2": {
      "name": "高级管理员",
      "permissions": [
        "view_dashboard",
        "manage_users",
        "manage_exams",
        "modify_system_settings",
        "approve_changes",
        "view_reports"
      ],
      "approval_required": false
    },
    "level_3": {
      "name": "超级管理员",
      "permissions": [
        "all"
      ],
      "approval_required": false
    }
  },
  "approval_workflow": {
    "steps": [
      "request_submission",
      "approval_review",
      "approval_decision",
      "implementation"
    ],
    "notification": true,
    "logging": true
  },
  "sensitive_operations": [
    "modify_system_settings",
    "change_user_roles",
    "modify_exam_parameters",
    "adjust_level_settings"
  ]
}