{
  "login_redirect": {
    "student": "/exam-system",
    "admin": "/admin/dashboard",
    "teacher": "/teacher/dashboard"
  },
  "level_detection": {
    "enabled": true,
    "default_level": "beginner",
    "levels": [
      "beginner",
      "intermediate",
      "advanced",
      "expert"
    ]
  },
  "placement_test": {
    "enabled": true,
    "trigger_conditions": [
      "level_empty",
      "level_not_detected"
    ]
  }
}