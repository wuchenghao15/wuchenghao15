# MTSCOS 登录系统环境配置文件
# 请根据实际环境修改以下配置

# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mtscos_login
DB_USER=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 密码安全配置
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=128

# 登录安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15
LOCKOUT_DURATION=30
SESSION_TIMEOUT=3600

# 限流配置
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# CORS配置
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# 第三方登录配置
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# 微信登录
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_CALLBACK_URL=http://localhost:3001/api/auth/wechat/callback

# QQ登录
QQ_APP_ID=your_qq_app_id
QQ_APP_KEY=your_qq_app_key
QQ_CALLBACK_URL=http://localhost:3001/api/auth/qq/callback

# 支付宝登录
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_CALLBACK_URL=http://localhost:3001/api/auth/alipay/callback

# 邮件配置（用于密码重置等）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=MTSCOS <noreply@mtscos.com>

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# 文件上传配置
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# 安全配置
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
TRUST_PROXY=false

# 开发配置
DEBUG_MODE=false
MOCK_OAUTH=false
SKIP_EMAIL_VERIFICATION=false

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# API配置
API_VERSION=v1
API_PREFIX=/api
DOCS_ENABLED=true

# 数据库连接池配置
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis连接池配置
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
REDIS_POOL_ACQUIRE=30000
REDIS_POOL_IDLE=10000

# 会话配置
SESSION_SECRET=your_session_secret_key_here
SESSION_NAME=mtscos_session
SESSION_ROLLING=true
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false

# 验证码配置
CAPTCHA_EXPIRES=300
CAPTCHA_LENGTH=6
CAPTCHA_MATH_ENABLED=true
CAPTCHA_SLIDE_ENABLED=false

# 双因素认证配置
TFA_ENABLED=false
TFA_ISSUER=MTSCOS
TFA_WINDOW=1

# 审计日志配置
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_FILE=logs/audit.log

# 性能配置
ENABLE_PROFILING=false
SLOW_QUERY_THRESHOLD=1000
MEMORY_THRESHOLD=0.8

# 备份配置
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups