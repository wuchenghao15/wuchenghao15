# 灰度测试环境配置示例
NODE_ENV=staging
TEST_MODE=true
LOG_LEVEL=debug
DATA_SOURCE=test
API_ENDPOINT=http://localhost:8081/api

# 安全配置
JWT_SECRET=your_jwt_secret_key
API_KEY=your_api_key

# 数据库配置
DB_HOST=localhost
DB_PORT=27017
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# 性能设置
MAX_CONNECTIONS=10
TIMEOUT=30000
